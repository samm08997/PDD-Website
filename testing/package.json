{
  "name": "cramAI-test-suite",
  "version": "1.0.0",
  "description": "End-to-End Testing Suite for CramAI — Selenium (Web) + Appium (Mobile) with Excel Report Generation",
  "main": "run-all.js",
  "scripts": {
    "test": "node test.js",
    "test:web": "node run-web.js",
    "test:mobile": "node run-mobile.js",
    "test:all": "node run-all.js",
    "test:api": "mocha selenium/07_api/api.test.js --timeout 30000"
  },
  "dependencies": {
    "selenium-webdriver": "^4.18.1",
    "chromedriver": "^124.0.0",
    "mocha": "^10.4.0",
    "chai": "^4.4.1",
    "exceljs": "^4.4.0",
    "webdriverio": "^8.39.0",
    "@wdio/appium-service": "^8.39.0",
    "axios": "^1.7.2",
    "uuid": "^9.0.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/chai": "^4.3.14"
  },
  "allowScripts": {
    "chromedriver@124.0.4": true
  }
}